<launch>

  <arg name="world_name" default="real_world"/>
  <arg name="sensorOffsetX" default="0.0"/>
  <arg name="sensorOffsetY" default="0.0"/>
  <arg name="cameraOffsetZ" default="0.0"/>
  <arg name="vehicleX" default="0.0"/>
  <arg name="vehicleY" default="0.0"/>
  <arg name="checkTerrainConn" default="true"/>
  <!-- Odometry fault-injection wiring, one switch for both odom and TF.
       true:  Point-LIO publishes /state_estimation_raw and its TF on
              /tf_slam_raw; you MUST also launch the injector, which then
              owns /state_estimation and the camera_init->aft_mapped TF:
                ros2 launch odom_fault_injection state_estimation_fault.launch.py
       false: normal direct wiring, no injector needed. -->
  <arg name="faultInjection" default="false"/>
  <!-- true: pathFollower drives the real Go2 via the Unitree sport API -->
  <arg name="is_real_robot" default="false"/>
  <!-- Input cloud for terrain_analysis (e.g. /registered_scan or /merged_scan) -->
  <arg name="pointCloudTopic" default="/merged_scan"/>

  <node pkg="joy" exec="joy_node" name="ps3_joy" output="screen" >
    <param name="dev" value="/dev/input/js0" />
    <param name="deadzone" value="0.12" />
    <param name="autorepeat_rate" value="0.0" />
  </node>
  
  <!-- <node pkg="go2_h264_repub" exec="go2_h264_repub" name="go2_h264_repub" output="screen">
    <param name="multicast_iface" value="enp3s0"/> 
  </node> -->

  <!-- MID360 LiDAR driver -->
  <node pkg="livox_ros_driver2" exec="livox_ros_driver2_node" name="livox_lidar_publisher" output="screen">
    <param name="xfer_format" value="0"/>
    <param name="multi_topic" value="0"/>
    <param name="data_src" value="0"/>
    <param name="publish_freq" value="10.0"/>
    <param name="output_data_type" value="0"/>
    <param name="frame_id" value="livox_frame"/>
    <param name="user_config_path" value="$(find-pkg-share livox_ros_driver2)/config/MID360_config.json"/>
  </node>

  <group if="$(var faultInjection)">
    <include file="$(find-pkg-share point_lio_unilidar)/launch/mapping_mid360.launch">
      <arg name="rviz" value="false"/>
      <arg name="odom_topic" value="/state_estimation_raw"/>
      <arg name="tf_topic" value="/tf_slam_raw"/>
    </include>
  </group>

  <group unless="$(var faultInjection)">
    <include file="$(find-pkg-share point_lio_unilidar)/launch/mapping_mid360.launch">
      <arg name="rviz" value="false"/>
    </include>
  </group>

  <include file="$(find-pkg-share local_planner)/launch/local_planner.launch" >
    <arg name="sensorOffsetX" value="$(var sensorOffsetX)" />
    <arg name="sensorOffsetY" value="$(var sensorOffsetY)" />
    <arg name="cameraOffsetZ" value="$(var cameraOffsetZ)"/>
    <arg name="goalX" value="$(var vehicleX)"/>
    <arg name="goalY" value="$(var vehicleY)"/>
    <arg name="is_real_robot" value="$(var is_real_robot)"/>
  </include>

  <include file="$(find-pkg-share terrain_analysis)/launch/terrain_analysis.launch" >
    <arg name="pointCloudTopic" value="$(var pointCloudTopic)"/>
  </include>

  <!-- go2 legacy -->
  <!-- <node pkg="transform_sensors" exec="transform_everything" name="transform_everything" output="screen" /> --> 
  <node pkg="unitree_lidar_fix" exec="cloud_merger" name="cloud_merger" output="screen"/>

  <!-- <include file="$(find-pkg-share terrain_analysis_ext)/launch/terrain_analysis_ext.launch" >
    <arg name="checkTerrainConn" value="$(var checkTerrainConn)"/>
  </include> -->

  <!-- <include file="$(find-pkg-share sensor_scan_generation)/launch/sensor_scan_generation.launch" /> -->

  <!-- <include file="$(find-pkg-share visualization_tools)/launch/visualization_tools.launch" >
    <arg name="world_name" value="$(var world_name)"/>
  </include> -->

  <node launch-prefix="nice" pkg="rviz2" exec="rviz2" name="rvizGA" args="-d $(find-pkg-share vehicle_simulator)/rviz/vehicle_simulator.rviz"/>

  <node pkg="tf2_ros" exec="static_transform_publisher" name="loamInterfaceTransPubMap" args="0 0 0 0 0 0 /map /camera_init"/>

  <!-- SLAM odometry output frame renamed from sensor to mid360 -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="loamInterfaceTransPubVehicle" args="0 0 0 0 0 0 /aft_mapped /mid360"/>

  <!-- Go2W robot description: broadcasts mid360 → base_link → all URDF links -->
  <include file="$(find-pkg-share go2w_description)/launch/go2w_description.launch.py"/>

</launch>
