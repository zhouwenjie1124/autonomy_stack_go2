<package format="3">
  <name>utlidar_obstacle_layer</name>
  <version>0.0.1</version>
  <description>Transforms Unitree L1 UTLidar cloud to map frame and injects it as obstacles for local_planner</description>
  <maintainer email="zhouwenjie1124@gmail.com">Wenjie Zhou</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
