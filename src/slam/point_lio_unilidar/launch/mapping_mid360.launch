<launch>
	<!-- Launch file for Livox Mid360 LiDAR mounted on Go2 -->
	<!-- No transform_sensors node needed: Mid360 outputs data directly in its own frame.
	     The 13-deg mounting tilt is compensated by Point-LIO's gravity_align. -->
	<arg name="rviz" default="true" />
	<!-- SLAM odom output topic. Set to /state_estimation_raw to splice the
	     odom_fault_injection node in front of the autonomy stack. -->
	<arg name="odom_topic" default="/state_estimation" />
	<!-- Where laserMapping broadcasts its camera_init -> aft_mapped TF.
	     Set to /tf_slam_raw so the odom_fault_injection node can own /tf. -->
	<arg name="tf_topic" default="/tf" />

	<node pkg="point_lio_unilidar" exec="pointlio_mapping" name="laserMapping" output="screen">
		<param from="$(find-pkg-share point_lio_unilidar)/config/mid360.yaml" />

		<param name="use_imu_as_input" value="false"/>

		<param name="prop_at_freq_of_imu" value="true"/>
		<param name="check_satu" value="true"/>
		<param name="init_map_size" value="10"/>
		<param name="point_filter_num" value="1"/>

		<param name="space_down_sample" value="true" />
		<param name="filter_size_surf" value="0.1" />
		<param name="filter_size_map" value="0.1" />
		<param name="cube_side_length" value="1000.0" />
		<param name="runtime_pos_log_enable" value="false" />

		<!-- Remap to match the downstream autonomy stack topic names -->
		<remap from="/cloud_registered" to="/registered_scan" />
		<remap from="/aft_mapped_to_init" to="$(var odom_topic)" />
		<remap from="/tf" to="$(var tf_topic)" />

	</node>

	<group if="$(var rviz)">
		<node launch-prefix="nice" pkg="rviz2" exec="rviz2" name="rviz" args="-d $(find-pkg-share point_lio_unilidar)/rviz_cfg/loam_livox2.rviz"/>
	</group>

</launch>
